{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ornith-1.5-35B-A3B (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Ornith-1.5-35B-A3B-GGUF": {
          "name": "Ornith-1.5-35B-A3B 35b (local)",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    }
  },
  "model": "llama-cpp/Ornith-1.5-35B-A3B-GGUF",
  "small_model": "llama-cpp/Ornith-1.5-35B-A3B-GGUF"
}
